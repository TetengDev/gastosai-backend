# Copy to ".env" in this folder and set your values.
# Real environment variables override these when present.
# application.properties maps these to Spring (DB_URL, OPENAI_API_KEY, etc.).

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/gastosai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# OpenAI (optional until you use POST /ai/query)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# true (default) = seed sample expenses when the table is empty; set false in production
GASTOS_SEED_SAMPLE_DATA=true
