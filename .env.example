# Copy to ".env" at the repo root and set your values.
# The backend loads it at startup; real environment variables override these when present.
# NEVER commit the real .env. Production values: see .env.prod.example.
#
# This file lists ONLY server-side configuration. Client-safe values (VITE_*) live in the
# gastosai-web repo — no provider key, DB credential, or JWT secret ever belongs there.

# ============ Database ============
# Optional for the local loop — these three are also the application defaults, and 5433 is the
# host port docker-compose.yaml publishes. Set them only when pointing at another database.
DB_URL=jdbc:postgresql://localhost:5433/gastos
DB_USERNAME=postgres
DB_PASSWORD=dev

# ============ AI provider ============
# GASTOS_AI_PROVIDER: openai (default) or claude
GASTOS_AI_PROVIDER=openai
# REQUIRED when the provider is openai — the property has no default; startup fails if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# true = your OPENAI_API_KEY serves all users (managed AI, per-plan quotas);
# false (default) = BYOK, each user adds their own key in Settings.
AI_ALLOW_SHARED_KEY=false
# Token cost rates (USD per million tokens). Defaults match gpt-4o-mini pricing.
# AI_COST_INPUT_PER_MTOK_USD=0.15
# AI_COST_OUTPUT_PER_MTOK_USD=0.60

# ============ App behavior ============
# true (default) = seed sample expenses when the table is empty; set false in production.
# When true, also seeds per-tier test accounts: free@/premium@/trial@gastosai.dev (free123/premium123/trial123).
GASTOS_SEED_SAMPLE_DATA=true

# Monetization master switch. false (default) = every feature is unlocked for every user
# (alpha/beta full access); the entitlement system stays wired but inert. Flip to true to
# enforce per-plan access (chat tones, category caps, premium-only features). ADMIN bypasses.
MONETIZATION_ENFORCE=false

# Per-plan category caps (only applied when monetization is enforced). 0 = unlimited.
GASTOS_LIMITS_CATEGORIES_FREE=5
GASTOS_LIMITS_CATEGORIES_PREMIUM=0
GASTOS_LIMITS_CATEGORIES_TRIAL=0

# ============ Free-tier abuse guards ============
# Per-IP daily cap on POST /auth/register and magic-link first-account creation.
# In-memory per-JVM; effective limit is N × this value on multi-instance deployments.
# REGISTER_IP_DAILY_MAX=5
# Global daily new-account cap (DB count of users.created_at >= start of today).
# REGISTER_DAILY_MAX=100
# Global daily AI request backstop across ALL users (SUCCESS rows in ai_usage); admin-exempt.
# AI_GLOBAL_DAILY_MAX=2000
# Per-authenticated-user/minute cap on write operations (POST/PUT/PATCH/DELETE) on app data paths.
# WRITE_RATE_LIMIT_PER_MINUTE=60

# PayMongo (payment integration — leave blank in dev to disable real charges)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Admin account — set both to auto-create a persistent admin account on startup.
# Leave blank (or omit) in production unless you need one.
GASTOS_ADMIN_EMAIL=
GASTOS_ADMIN_PASSWORD=

# Demo account seeded alongside the sample data (used for walkthroughs/screenshots).
GASTOS_DEMO_EMAIL=
GASTOS_DEMO_NAME=
GASTOS_DEMO_PASSWORD=

# ============ Operational alerts (docs/observability.md) ============
# Off by default; a no-op unless ALERTS_ENABLED=true AND the Telegram creds below are set.
# ALERTS_ENABLED=false
# ALERT_INTERVAL_MS=900000          # scheduler tick (15 min)
# ALERT_DAILY_COST_USD=5.00         # alert when today's AI spend exceeds this (USD)
# ALERT_ERROR_RATE=20               # alert when server errors/hour exceed this
# ALERT_GLOBAL_CAP_FRACTION=0.9     # alert at this fraction of AI_GLOBAL_DAILY_MAX
# Telegram bot used to deliver the alerts above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
