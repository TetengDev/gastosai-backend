{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(.agentic-team/**)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "developers-anthropic-skills@agentic-company-os": true,
    "developers@agentic-company-os": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agentic-company-os": {
      "source": {
        "source": "github",
        "repo": "TetengDev/agentic-company"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/../scripts/guard_main_merge.py\"",
            "timeout": 10,
            "statusMessage": "Checking the merge guard"
          }
        ]
      }
    ]
  }
}
