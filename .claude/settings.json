{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(.agentic-team/**)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/../scripts/guard_main_merge.py\"",
            "timeout": 10,
            "statusMessage": "Checking the merge guard"
          }
        ]
      }
    ]
  }
}
