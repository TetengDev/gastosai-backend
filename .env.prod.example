# Copy to `.env.prod` on the Oracle VM (NEVER commit the real file).
# Used by compose.prod.yml for both the API container and Caddy.

# --- Caddy / HTTPS ---
# Public hostname that resolves to this VM's IP (e.g. a free DuckDNS subdomain).
DOMAIN=gastosai.example.org

# --- CORS --- (your Vercel frontend origin; comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Database (Supabase Postgres, Session mode / port 5432) ---
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<supabase-password>

# --- Auth / crypto secrets (generate strong random values) ---
JWT_SECRET=<long-random-string>
AI_KEY_ENCRYPTION_SECRET=<32-byte-base64-or-long-random>

# --- AI provider ---
GASTOS_AI_PROVIDER=openai
OPENAI_API_KEY=<key>
OPENAI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=<key>          # if GASTOS_AI_PROVIDER=claude
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- App behavior ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
GASTOS_SEED_SAMPLE_DATA=false
AI_RATE_LIMIT_PER_MINUTE=10
MONETIZATION_ENFORCE=false

# --- Security hardening (0.46.0) ---
# Absolute monthly AI request ceiling per user, enforced even in BYOK mode (cost/abuse guard).
AI_ABSOLUTE_MONTHLY_CAP=1000
# Per-IP request budget for unauthenticated endpoints (login/register/magic-link/submissions) per minute.
PUBLIC_RATE_LIMIT_PER_MINUTE=10
# Global cap on magic-link emails sent per calendar day (across all addresses).
MAGIC_LINK_DAILY_MAX=200
# JWT access-token lifetime in ms (default 8h = 28800000).
JWT_EXPIRATION_MS=28800000
# NOTE: in the prod profile (or a remote DB), startup FAILS FAST if JWT_SECRET or
# AI_KEY_ENCRYPTION_SECRET still equals its dev default — set both to strong random values above.

# --- Free-tier abuse guards ---
# Per-IP daily cap on new account creation (POST /auth/register + magic-link first-account path).
# In-memory per-JVM; set RATELIMIT_REDIS_ENABLED=true before scaling horizontally.
REGISTER_IP_DAILY_MAX=5
# Global daily cap on new accounts (DB count). Rejects registration when reached.
REGISTER_DAILY_MAX=100
# Global daily AI request backstop across all users (SUCCESS rows in ai_usage). Admin-exempt.
AI_GLOBAL_DAILY_MAX=2000
# Per-authenticated-user/minute cap on write operations on app data paths.
WRITE_RATE_LIMIT_PER_MINUTE=60

# --- Shared rate-limit store (0.48.0, optional — only for multi-instance API) ---
# Leave false for a single instance (per-JVM in-memory limiter, no Redis needed).
# Set true + start the redis service (docker compose --profile redis ... up -d) to share
# rate-limit counters across instances before horizontal scaling.
RATELIMIT_REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# --- Managed AI (optional) ---
# Leave AI_ALLOW_SHARED_KEY=false for BYOK (each user adds their own key).
# Set it true + a funded OPENAI_API_KEY above to serve AI from a shared key with
# per-plan monthly quotas. If true and the active provider key is blank, startup fails fast.
AI_ALLOW_SHARED_KEY=false
# Token cost rates (USD per million tokens) used for ai_usage.estimated_cost_usd.
# Defaults match gpt-4o-mini; override when switching to a different model/provider.
AI_COST_INPUT_PER_MTOK_USD=0.15
AI_COST_OUTPUT_PER_MTOK_USD=0.60
AI_FEATURES_ENABLED=true
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_PROMPT_CHARS=8000
AI_MONTHLY_FREE_QUOTA=30
AI_MONTHLY_PREMIUM_QUOTA=300
AI_MONTHLY_TRIAL_QUOTA=50
AI_VISION_FREE_QUOTA=5
AI_VISION_PREMIUM_QUOTA=50
AI_VISION_TRIAL_QUOTA=10

# --- PayMongo (payment integration) ---
PAYMONGO_SECRET_KEY=<sk_live_...>
PAYMONGO_WEBHOOK_SECRET=<whsec_...>

# --- Email / magic-link login ---
# Leave MAIL_HOST blank to disable real email (the sign-in link is logged instead — dev only).
# For prod, set SMTP creds (e.g. Gmail app password) so magic-link emails are delivered.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@gastosai.app
FRONTEND_BASE_URL=https://your-app.vercel.app
MAGICLINK_TTL_MINUTES=15

# ---- Operational alerts (docs/observability.md) ----
# Off unless ALERTS_ENABLED=true AND both Telegram creds are set. Reuses the tooling bot.
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_INTERVAL_MS=900000
ALERT_DAILY_COST_USD=5.00
ALERT_ERROR_RATE=20
ALERT_GLOBAL_CAP_FRACTION=0.9
