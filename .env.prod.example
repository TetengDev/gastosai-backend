# Copy to `.env.prod` on the Oracle VM (NEVER commit the real file).
# Used by compose.prod.yml for both the API container and Caddy.

# --- Caddy / HTTPS ---
# Public hostname that resolves to this VM's IP (e.g. a free DuckDNS subdomain).
DOMAIN=gastosai.example.org

# --- CORS --- (your Vercel frontend origin; comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Database (Supabase Postgres, Session mode / port 5432) ---
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<supabase-password>

# --- Auth / crypto secrets (generate strong random values) ---
JWT_SECRET=<long-random-string>
AI_KEY_ENCRYPTION_SECRET=<32-byte-base64-or-long-random>

# --- AI provider ---
GASTOS_AI_PROVIDER=openai
OPENAI_API_KEY=<key>
OPENAI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=<key>          # if GASTOS_AI_PROVIDER=claude
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- App behavior ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
GASTOS_SEED_SAMPLE_DATA=false
AI_RATE_LIMIT_PER_MINUTE=10
MONETIZATION_ENFORCE=false
