@tetengdev:registry=https://npm.pkg.github.com
# NODE_AUTH_TOKEN is what actions/setup-node populates, so publishing uses the workflow's
# built-in GITHUB_TOKEN — a short-lived credential scoped to a single run — instead of a
# long-lived PAT. The package and this repo share the TetengDev owner, which is what makes
# that sufficient. Never inline a token here.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
