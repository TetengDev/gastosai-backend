#!/bin/sh
# Validates that the commit message follows Conventional Commits format:
#   type(scope): description
#   type!: description  (breaking change shorthand)
#
# Valid types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert
#
# Version bumps are NOT enforced here — run scripts/bump-version.sh before opening a PR
# that should ship a new release.

msg=$(cat "$1")

# Allow merge commits, revert commits, and fixup commits to bypass format check
if echo "$msg" | grep -qE "^(Merge|Revert|fixup!|squash!)"; then
  exit 0
fi

if ! echo "$msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\([^)]+\))?!?: .{1,}"; then
  echo ""
  echo "Invalid commit message format."
  echo ""
  echo "Expected: type(scope): description"
  echo "Example : feat(expenses): add parse endpoint for natural-language input"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo "Append '!' for breaking changes: feat!: drop legacy auth endpoint"
  echo ""
  exit 1
fi
